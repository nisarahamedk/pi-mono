# syntax=docker/dockerfile:1.7
FROM node:20-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Base utilities + common CLI tooling
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    wget \
    git \
    jq \
    ripgrep \
    file \
    less \
    nano \
    unzip \
    zip \
    tar \
    procps \
    openssh-client \
    gnupg \
    socat \
    python3 \
    python3-pip \
    python3-venv \
  && rm -rf /var/lib/apt/lists/*

# Chromium + minimal fonts for headless browsing/scraping.
# (Avoid runtime browser downloads in restricted sandboxes.)
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    fonts-noto-color-emoji \
  && rm -rf /var/lib/apt/lists/*

# Enable pnpm (often useful for JS repos)
RUN corepack enable \
  && corepack prepare pnpm@latest --activate

# Install uv/uvx for Python package and script workflows
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
  && ln -sf /root/.local/bin/uv /usr/local/bin/uv \
  && ln -sf /root/.local/bin/uvx /usr/local/bin/uvx

# Prevent Playwright/Puppeteer from downloading browsers at install time.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PUPPETEER_SKIP_DOWNLOAD=1

# Install browser automation CLI.
# Note: use host-browser CDP bridge (127.0.0.1:<port>) for tools that require local CDP.
ARG UPWORK_CLI_REF=main
ARG UPWORK_CLI_CACHE_BUST=0
RUN --mount=type=secret,id=github_token,required=false \
    echo "Installing upwork-cli from github.com/nisarahamedk/upwork-cli#${UPWORK_CLI_REF} cache-bust=${UPWORK_CLI_CACHE_BUST}" \
 && npm install -g agent-browser \
 && if [ -f /run/secrets/github_token ]; then \
      GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
      git clone --depth 1 --branch "${UPWORK_CLI_REF}" "https://x-access-token:${GITHUB_TOKEN}@github.com/nisarahamedk/upwork-cli.git" /tmp/upwork-cli; \
    else \
      git clone --depth 1 --branch "${UPWORK_CLI_REF}" https://github.com/nisarahamedk/upwork-cli.git /tmp/upwork-cli; \
    fi \
 && cd /tmp/upwork-cli \
 && pnpm install --frozen-lockfile \
 && pnpm run build \
 && npm pack --pack-destination /tmp \
 && npm install -g /tmp/upwork-cli-*.tgz \
 && rm -rf /tmp/upwork-cli /tmp/upwork-cli-*.tgz
